rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared public access for land_donors, and backend-admin access for others
    match /land_donors/{docId} {
      allow read, write: if true;
    }

    match /users/{docId} { allow read, write: if true; }
    match /students/{docId} { allow read, write: if true; }
    match /teachers/{docId} { allow read, write: if true; }
    match /admissions/{docId} { allow read, write: if true; }
    match /donations/{docId} { allow read, write: if true; }
    match /donors/{docId} { allow read, write: if true; }
    match /gallery/{docId} { allow read, write: if true; }
    match /settings/{docId} { allow read, write: if true; }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
